# Copy to .env.local (gitignored) and fill in. Every value is optional:
# anything left empty falls back to the in-app settings panel, then to the
# built-in defaults.

# OpenAI-compatible API base URL (default: https://api.abliteration.ai/v1)
OGCHAT_API_BASE_URL=

# Provider API key. Stays on the server; the browser never receives it.
OGCHAT_API_KEY=

# Model id (default: abliterated-model-large-v2)
OGCHAT_MODEL=

# Claude, instead of the provider above (switch to it in settings).
# An Anthropic API key, and optionally a GitHub fine-grained token so Claude
# can work on a repository tied to a project. Names only here: never commit values.
ANTHROPIC_API_KEY=
OGCHAT_GITHUB_TOKEN=

# Where sessions and settings are stored (default: ./data)
OGCHAT_DATA_DIR=

# Extra hostnames allowed to reach the API, comma separated. Only needed if
# you serve ogchat on something other than localhost.
OGCHAT_ALLOWED_HOSTS=
