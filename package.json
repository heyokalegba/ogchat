{
  "name": "ogchat",
  "version": "0.1.0",
  "private": true,
  "description": "A personal, local-only AI chat interface.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock-provider": "node scripts/mock-provider.mjs",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
